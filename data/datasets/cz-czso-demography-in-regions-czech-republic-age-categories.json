{
  "identifier": "cz-czso-demography-in-regions-czech-republic-age-categories",
  "title": "Number of inhabitants in districts of Czech Republic in 5year age categories",
  "description": {
    "en": "This dataset contains numbers of inhabitants in districts of Czech Republic in age categories splited in 5year intervals with a distinguished category 0 years. The last age category is 90-94 years. All older categories are aggregated to 95 years and more. The dataset distinguishes males and females."
  },
