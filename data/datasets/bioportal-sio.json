{
  "identifier": "bioportal-sio",
  "title": "SemanticScience Integrated Ontology",
  "description": {
    "en": "The semanticscience integrated ontology (SIO) provides a simple, integrated upper level ontology (types, relations) for consistent knowledge representation across physical, processual and informational entities. It provides vocabulary for the Bio2RDF (http://bio2rdf.org) and SADI (http://sadiframework.org) projects."
  },
