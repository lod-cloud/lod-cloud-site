{
  "identifier": "bio2rdf-gendr",
  "title": "Bio2RDF::Gendr",
  "description": {
    "en": "GenDR is a database of genes associated with dietary restriction (DR). GenDR includes two datasets: 1) genes inferred from experiments in model organisms in which genetic manipulations cancel out or disrupt the life-extending effects of DR; 2) genes robustly altered due to DR, derived from a meta-analysis of microarray DR studies in mammals"
  },
